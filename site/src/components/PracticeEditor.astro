---
import { Code } from 'astro-expressive-code/components';

const { lessonId, practice, showHelp = false } = Astro.props;

function escapeHtml(value) {
  return String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function inline(value) {
  return escapeHtml(value).replace(/`([^`]+)`/g, '<code>$1</code>');
}

const defaultStarter = '# Напиши решение здесь\n';
const prerequisites = Array.isArray(practice.steps) ? practice.steps : [];

const allSteps = prerequisites.length
  ? [
      ...prerequisites.map((step, index) => ({
        ...step,
        key: `${lessonId}--step-${index + 1}`,
        label: step.label ?? `Шаг ${index + 1}`,
        isMain: false,
        task: step.task ?? '',
        hint: step.hint ?? '',
        starter: step.starter ?? defaultStarter,
        solution: step.solution ?? '',
        tests: step.tests ?? []
      })),
      {
        ...practice,
        steps: undefined,
        key: lessonId,
        label: practice.mainLabel ?? 'Основная задача',
        isMain: true,
        starter: practice.starter ?? defaultStarter,
        solution: practice.solution ?? '',
        tests: practice.tests ?? []
      }
    ]
  : [
      {
        ...practice,
        key: lessonId,
        label: practice.mainLabel ?? 'Задача',
        isMain: true,
        starter: practice.starter ?? defaultStarter,
        solution: practice.solution ?? '',
        tests: practice.tests ?? []
      }
    ];

const current = allSteps[0];
const starter = current.starter;
const solution = current.solution;
const tests = current.tests;
const hasSteps = allSteps.length > 1;

const stepsJson = JSON.stringify(
  allSteps.map((step) => ({
    key: step.key,
    label: step.label,
    isMain: Boolean(step.isMain),
    starter: step.starter,
    tests: step.tests,
    solution: step.solution
  }))
).replace(/</g, '\\u003c');
const testsJson = JSON.stringify(tests).replace(/</g, '\\u003c');
const solutionJson = JSON.stringify(solution).replace(/</g, '\\u003c');
const starterJson = JSON.stringify(starter).replace(/</g, '\\u003c');
---

<div class="practice-editor-card" data-practice data-lesson-id={lessonId} data-practice-key={current.key}>
  <div class="practice-header">
    <div>
      <p class="eyebrow">Интерактив</p>
      <h2 id="practice" class="practice-title">Практика</h2>
    </div>
    <span class="practice-badge" data-practice-status>черновик</span>
  </div>

  {
    hasSteps && (
      <nav class="practice-stepnav" data-practice-stepnav aria-label="Шаги практики">
        {allSteps.map((step, index) => (
          <button
            type="button"
            class="practice-step"
            data-practice-step={index}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls="practice-panel"
          >
            <span class="practice-step-index" aria-hidden="true">{index + 1}</span>
            <span class="practice-step-label">{step.label}</span>
            <span class="practice-step-mark" data-practice-step-mark={index} aria-hidden="true"></span>
          </button>
        ))}
      </nav>
    )
  }

  {
    hasSteps && (
      <p class="practice-stepnote">
        Сначала короткие шаги, потом основная задача. Основная задача отмечает урок пройденным.
      </p>
    )
  }

  {
    allSteps.map((step, index) => (
      <div data-practice-step-task={index} hidden={index !== 0}>
        <p class="practice-task" set:html={inline(step.task)}></p>
      </div>
    ))
  }

  <div class="practice-editor" id="practice-panel">
    <div class="practice-editor-top">
      <span class="practice-editor-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="practice-editor-file">solution.py</span>
      <span class="practice-editor-hint">Ctrl+Space — подсказка · Ctrl+Enter — проверить</span>
    </div>
    <div class="practice-editor-body is-code">
      <div class="practice-codemirror" data-practice-codemirror></div>
      <noscript>
        <textarea class="practice-fallback" aria-label="Твой код" spellcheck="false">{starter}</textarea>
      </noscript>
    </div>
  </div>

  <div class="practice-actions">
    <button type="button" class="course-btn course-btn-primary" data-practice-check>Проверить</button>
    <button type="button" class="course-btn course-btn-ghost" data-practice-reset>Сбросить</button>
    <span class="practice-feedback" data-practice-feedback role="status" aria-live="polite"></span>
  </div>

  <div class="practice-result" data-practice-result hidden></div>

  {
    allSteps.map((step, index) => (
      <div data-practice-step-details={index} hidden={index !== 0}>
        <div class="practice-details-grid">
          {step.hint && (
            <details class="practice-details">
              <summary>Подсказка</summary>
              <p set:html={inline(step.hint)}></p>
            </details>
          )}

          {step.solution && (
            <details class="practice-details">
              <summary>Показать решение</summary>
              <p class="section-note">
                Сначала попробуй сам. Решение — один из вариантов, а не единственно правильный.
              </p>
              <Code code={step.solution} lang="python" title="Решение" frame="code" showLineNumbers={false} />
            </details>
          )}
        </div>
      </div>
    ))
  }

  {
    showHelp && (
      <details class="practice-note">
        <summary>Как работает проверка</summary>
        <p>
          Код выполняется прямо в браузере через <strong>Pyodide</strong> — это Python, скомпилированный
          в WebAssembly. Первый запуск скачивает среду с CDN и занимает несколько секунд, дальше всё
          работает локально. Никакой код не отправляется на сервер.
        </p>
        <p>
          После выполнения запускаются тесты из урока. Если Pyodide недоступен (например, нет интернета),
          остаётся структурная проверка: скобки, TODO и близость к эталону. Она не выполняет код.
        </p>
        <p>
          В браузере нет вашего терминала и файлов с компьютера: <code>input()</code>, сеть и реальные
          файлы недоступны. Передавайте данные аргументами функции и запускайте такие примеры локально;
          для текста можно использовать <code>io.StringIO</code>.
        </p>
      </details>
    )
  }

  <script type="application/json" data-practice-steps set:html={stepsJson}></script>
  <script type="application/json" data-practice-starter set:html={starterJson}></script>
  <script type="application/json" data-practice-tests set:html={testsJson}></script>
  <script type="application/json" data-practice-solution set:html={solutionJson}></script>
</div>

<script>
  import '../scripts/practice.js';
</script>
