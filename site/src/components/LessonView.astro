---
import { Code } from 'astro-expressive-code/components';
import Quiz from './Quiz.astro';
import ProgressToggle from './ProgressToggle.astro';
import SourceCode from './SourceCode.astro';
import FullSource from './FullSource.astro';
import LessonNav from './LessonNav.astro';
import LessonRail from './LessonRail.astro';
import PracticeEditor from './PracticeEditor.astro';
import generated from '../data/generated.json';
import { courseStats } from '../data/course.mjs';
import { githubSourcePath, moduleUrl } from '../utils/url.js';

const { lesson, module, prev, next, hasFullSource = true } = Astro.props;
const sources = lesson.sources;
const fullSources = sources.filter((source) => !(source.focus ?? []).some((focus) => focus.full));
const outputs = sources
  .map((source) => ({ file: source.file, entry: generated.files[source.file] }))
  .filter((item) => item.entry);

function escapeHtml(value) {
  return String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function inline(value) {
  return escapeHtml(value).replace(/`([^`]+)`/g, '<code>$1</code>');
}
---

<div class="lesson">
  <div class="lesson-kicker">
    <a class="module-pill" style={`--module-color:${module.color}`} href={moduleUrl(module)}>
      Модуль {module.number} · {module.title}
    </a>
    <span>Урок {lesson.order} из {courseStats.lessons}</span>
    <span>~{lesson.minutes} мин</span>
  </div>

  <p class="lesson-lead">{lesson.summary}</p>

  <div class="lesson-actions">
    <ProgressToggle lessonId={lesson.id} />
    <a class="course-btn course-btn-ghost" href={moduleUrl(module)}>Все уроки модуля</a>
  </div>

  <LessonRail />

  <section class="lesson-section lesson-goal">
    <h2 id="goal">Цель урока</h2>
    <p set:html={inline(lesson.goal)}></p>
  </section>

  <section class="lesson-section">
    <h2 id="ideas">Ключевые идеи</h2>
    <ul class="idea-list">
      {lesson.ideas.map((idea) => <li set:html={inline(idea)}></li>)}
    </ul>
  </section>

  <section class="lesson-section">
    <h2 id="code">Код</h2>
    <p class="section-note">
      Ниже — фрагменты из реального файла. Номера строк совпадают с исходником в репозитории.
    </p>
    {
      sources.map((source, sourceIndex) => {
        const focuses = source.focus ?? [{ full: true }];
        return (
          <div class="lesson-source">
            <div class="lesson-source-head">
              <code>src/python/{source.file}</code>
              <a href={githubSourcePath(source.file)} target="_blank" rel="noreferrer">
                Открыть на GitHub ↗
              </a>
            </div>
            {(focuses.length > 1 || !focuses[0].full) && (
              <nav class="source-toc" aria-label="Фрагменты файла">
                <span class="source-toc-label">В файле:</span>
                {focuses.map((focus, focusIndex) => (
                  <a href={`#source-${sourceIndex}-${focusIndex}`}>
                    {focus.function || (focus.full ? 'файл целиком' : `строки ${focus.lines[0]}–${focus.lines[1]}`)}
                  </a>
                ))}
              </nav>
            )}
            {focuses.map((focus, focusIndex) => (
              <SourceCode
                id={`source-${sourceIndex}-${focusIndex}`}
                file={source.file}
                focus={focus}
                note={focus.note}
              />
            ))}
          </div>
        );
      })
    }
  </section>

  {
    outputs.length > 0 && (
      <section class="lesson-section lesson-output">
        <h2 id="output">Что выводит программа</h2>
        <p class="section-note">
          Вывод получен реальным запуском файла на Python. В примерах с случайностью или временем
          значения могут отличаться.
        </p>
        {outputs.map(({ file, entry }) => (
          <div class="output-block">
            <div class="output-label">
              <span>{file.split('/').pop()}</span>
              {entry.ok ? <span class="output-ok">запущено</span> : <span class="output-fail">ошибка запуска</span>}
            </div>
            {entry.ok ? (
              entry.output.split('\n').length > 26 ? (
                <details class="output-details">
                  <summary>Показать вывод · {entry.output.split('\n').length} строк</summary>
                  <Code code={entry.output} lang="text" title="stdout" frame="terminal" showLineNumbers={false} />
                </details>
              ) : (
                <Code code={entry.output} lang="text" title="stdout" frame="terminal" showLineNumbers={false} />
              )
            ) : (
              <pre class="output-error">{entry.error}</pre>
            )}
          </div>
        ))}
      </section>
    )
  }

  <section class="lesson-section practice-section">
    <PracticeEditor lessonId={lesson.id} practice={lesson.practice} showHelp={lesson.order === 1} />
  </section>

  <section class="lesson-section quiz-section">
    <h2 id="quiz">Проверь себя</h2>
    <Quiz questions={lesson.quiz} />
  </section>

  {
    hasFullSource && (
      <section class="lesson-section">
        <h2 id="full">Полный исходник</h2>
        <p class="section-note">
          Файлы целиком — для тех, кто хочет посмотреть контекст. В основном тексте выше — только важные фрагменты.
        </p>
        {fullSources.map((source) => <FullSource file={source.file} />)}
      </section>
    )
  }

  <div class:list={['lesson-footer', !prev && 'is-first']}>
    <div class="lesson-complete">
      <ProgressToggle lessonId={lesson.id} />
    </div>
    <LessonNav prev={prev} next={next} />
  </div>
</div>

<script>
  import '../scripts/lesson.js';
</script>

